rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sports_feed/{feed} {
      allow get: if request.auth != null && feed in ['current', 'current_v2'];
    }
    match /app_content/{catalog} {
      allow get: if request.auth != null;
    }
    match /public_media/{media} {
      allow get: if request.auth != null;
      match /chunks/{chunk} { allow get: if request.auth != null; }
      match /releases/{release}/chunks/{chunk} { allow get: if request.auth != null; }
    }
    // Personal encrypted backups are isolated per verified, non-anonymous account.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /users/{uid}/state/current {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['latest'])
        && request.resource.data.latest is string
        && request.resource.data.latest.size() <= 40;
    }
    match /users/{uid}/personal_versions/{backupId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['createdAt','chunks','size','sha256','complete'])
        && request.resource.data.createdAt is int
        && request.resource.data.chunks is int
        && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 18
        && request.resource.data.size is int
        && request.resource.data.size > 0 && request.resource.data.size <= 8388608
        && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64
        && request.resource.data.complete is bool;
      match /chunks/{chunkId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && chunkId.matches('[0-9]{1,2}')
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 480000;
      }
    }
  }
}
